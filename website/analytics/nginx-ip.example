# Include in nginx's http context. Replace the documentation IP with your VPS IP.
# Requires ngx_http_geoip2_module and a local Country MMDB, never client geo headers.
# Enable the :80 server FIRST; add :443 only after issuing a trusted IP certificate.
geoip2 /var/lib/mukhomor-geo/country.mmdb {
    auto_reload 1h;
    $analytics_country default=ZZ source=$realip_remote_addr country iso_code;
}
limit_req_zone $binary_remote_addr zone=mukhomor_ip:2m rate=2r/s;
limit_req_zone $server_name zone=mukhomor_all:32k rate=50r/s;
limit_conn_zone $binary_remote_addr zone=mukhomor_conn:2m;

server {
    listen 80;
    server_name 203.0.113.10;
    access_log off;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 404; }
}
server {
    listen 443 ssl;
    server_name 203.0.113.10;
    ssl_certificate /etc/letsencrypt/live/203.0.113.10/fullchain.pem;
    # Browsers may first try plain HTTP when the operator enters IP:port.
    error_page 497 =308 https://203.0.113.10:$server_port$request_uri;
    ssl_certificate_key /etc/letsencrypt/live/203.0.113.10/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MukhomorTLS:2m;
    server_tokens off;
    access_log off;
    # Request errors can contain IPs: no per-request logs for this analytics vhost.
    error_log /dev/null crit;
    client_max_body_size 4k;
    client_body_buffer_size 4k;
    client_body_timeout 5s;
    client_header_timeout 5s;
    keepalive_timeout 5s;
    limit_req_status 429;
    limit_conn_status 429;
    location = /v1/site {
        if ($args != "") { return 400; }
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        limit_req zone=mukhomor_ip burst=10 nodelay;
        limit_req zone=mukhomor_all burst=50 nodelay;
        limit_conn mukhomor_conn 5;
        proxy_pass http://127.0.0.1:8787;
        proxy_pass_request_headers off;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Origin $http_origin;
        proxy_set_header If-None-Match $http_if_none_match;
        proxy_set_header X-Analytics-IP $realip_remote_addr;
        include /etc/mukhomor-analytics/proxy.headers;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_next_upstream off;
    }
    location ~ ^/v1/(session|event)$ {
        if ($args != "") { return 400; }
        if ($http_origin != "https://0nionow1.github.io") { return 403; }
        if ($request_method !~ ^(POST|OPTIONS)$) { return 405; }
        limit_req zone=mukhomor_ip burst=10 nodelay;
        limit_req zone=mukhomor_all burst=50 nodelay;
        limit_conn mukhomor_conn 5;
        proxy_pass http://127.0.0.1:8787;
        proxy_pass_request_headers off;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Origin $http_origin;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Content-Encoding $http_content_encoding;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Access-Control-Request-Method $http_access_control_request_method;
        proxy_set_header Access-Control-Request-Headers $http_access_control_request_headers;
        proxy_set_header X-Analytics-IP $realip_remote_addr;
        proxy_set_header X-Analytics-Country $analytics_country;
        # Root-owned private file: proxy_set_header X-Analytics-Proxy-Key "<64 hex>";
        include /etc/mukhomor-analytics/proxy.headers;
        proxy_connect_timeout 2s;
        proxy_read_timeout 8s;
        proxy_send_timeout 8s;
        proxy_next_upstream off;
    }
    # Admin is authenticated by Node; no cross-origin API access or proxy cache.
    location ~ ^/admin(?:/|$) {
        # Node accepts the larger JSON only after full MFA and CSRF validation.
        client_max_body_size 258k;
        proxy_request_buffering off;
        if ($request_method !~ ^(GET|HEAD|POST)$) { return 405; }
        limit_req zone=mukhomor_ip burst=10 nodelay;
        limit_req zone=mukhomor_all burst=50 nodelay;
        limit_conn mukhomor_conn 5;
        proxy_pass http://127.0.0.1:8787;
        proxy_pass_request_headers off;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Origin $http_origin;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Content-Encoding $http_content_encoding;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
        proxy_set_header X-Admin-Request $http_x_admin_request;
        proxy_set_header X-CSRF-Token $http_x_csrf_token;
        proxy_set_header X-Analytics-Proto $scheme;
        proxy_set_header X-Analytics-Host $http_host;
        proxy_set_header X-Analytics-IP $realip_remote_addr;
        include /etc/mukhomor-analytics/proxy.headers;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_send_timeout 8s;
        proxy_next_upstream off;
        proxy_cache off;
        proxy_buffering off;
    }
    location / { return 404; }
}
